# Copy this file to ".env" for local development. NEVER commit ".env".
# Both values come from Supabase > Project Settings > API (or "API Keys").
# Only the public "anon" / "publishable" key belongs here.
# NEVER put the "service_role" / "secret" key in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY
